ENV=development                 # development | production
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me
MONGODB_URI=mongomock://        # in-memory, for trying it out; mongodb://localhost:27017 with `docker compose up -d mongo`
MONGODB_DB=attendance

AUTH_MODE=password              # password (HR gives ID + password) | entra (Microsoft sign-in)
DEV_LOGIN=true                  # development only: any email, no password
HR_ADMIN_EMAILS=hr1@company.com,hr2@company.com
INITIAL_HR_PASSWORD=            # first password for each HR email (AUTH_MODE=password); change it after signing in

# Only for AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

EMAIL_MODE=console              # console | graph
SENDER_MAILBOX=hr.attendance@company.com
EMAIL_CC=

WORKDAY_MIN_HOURS=5
OFFDAY_MIN_HOURS=8
PH_MIN_HOURS=5
ALLOWED_STATUSES=P,A,OFF,PH,CO,ML,PL
TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=25

SESSION_HOURS=8
EMAIL_PER_SECOND=2

# Container only (see gunicorn.conf.py)
# WEB_CONCURRENCY=2
# FRONTEND_DIST=/app/frontend/dist
